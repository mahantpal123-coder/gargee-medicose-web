# Server Environment Variables (Hostinger / Node.js)
NODE_ENV=production
PORT=3000
FRONTEND_ORIGIN=https://gargeemedicose.com

# Email System (Hostinger Business Email SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=your@gargeemedicose.com
SMTP_PASS=your_hostinger_email_password
OWNER_EMAIL=orders@gargeemedicose.com
INQUIRY_EMAIL=info@gargeemedicose.in

# Optional Email Fallback (Resend)
RESEND_API_KEY=your_resend_api_key_optional

# WhatsApp Gateway (CallMeBot)
WHATSAPP_OWNER_PHONE=+919993617796
CALLMEBOT_API_KEY=your_callmebot_api_key_optional

# Hostinger MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_hostinger_db_user
MYSQL_PASSWORD=your_hostinger_db_password
MYSQL_DATABASE=your_hostinger_db_name

# Razorpay Payment Gateway Credentials (Server-Side ONLY)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Firebase Admin SDK (Server-Side Persistence)
FIREBASE_PROJECT_ID=gargee-1d0ec
FIREBASE_CLIENT_EMAIL=your_firebase_admin_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----"

# Desktop Dashboard API Key (for Electron app to authenticate without Firebase Auth)
DASHBOARD_API_KEY=gm_dash_sec_change_this_to_random_string

# Shiprocket Logistics Integration (Optional - for courier shipping)
SHIPROCKET_EMAIL=your_shiprocket_account_email
SHIPROCKET_PASSWORD=your_shiprocket_account_password
SHIPROCKET_PICKUP_LOCATION=Primary

# Store Origin (for local vs out-of-city auto-detection)
STORE_CITY=Bilaspur
STORE_PINCODE=495001
STORE_STATE=Chhattisgarh

# Firebase Client Environment Variables (Built with Vite)
VITE_FIREBASE_API_KEY=your_firebase_client_api_key
VITE_FIREBASE_AUTH_DOMAIN=gargee-1d0ec.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gargee-1d0ec
VITE_FIREBASE_STORAGE_BUCKET=gargee-1d0ec.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=306357708775
VITE_FIREBASE_APP_ID=1:306357708775:web:cde14ae256c6ad976dbf42
VITE_FIREBASE_MEASUREMENT_ID=G-XQK129E0QQ
VITE_ADMIN_EMAILS=your_admin_email_1,your_admin_email_2
VITE_IMGBB_KEY=your_imgbb_key_optional
