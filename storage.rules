rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /product-images/{fileName} {
      allow read: if true;
      allow write: if true;
    }
    match /banners/{fileName} {
      allow read: if true;
      allow write: if true;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
