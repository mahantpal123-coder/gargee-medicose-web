rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read for store catalog, products, categories, business settings
    match /store_catalog/{document} {
      allow read: if true;
      allow write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
